# boow-control — variables d'environnement (toutes OPTIONNELLES).
# L'application a des valeurs par défaut raisonnables ; ce fichier documente
# ce que l'on peut surcharger. Copiez-le en `.env` et remplissez au besoin.
# (Le `.env` réel est ignoré par git.)

# ── Ports & réseau ───────────────────────────────────────────────────────
BOOW_DAEMON_PORT=            # défaut : 8788
BOOW_WEB_PORT=               # défaut : 5180
BOOW_HOST=                   # défaut : 0.0.0.0

# ── Cerveaux locaux (endpoint OpenAI-compatible d'un llama-server) ────────
BOOW_BRAIN_URL=              # défaut : http://localhost:8080/v1
BOOW_BRAIN_MODEL=            # défaut : qwen3.6-35b
BOOW_BRAIN_CODER=            # modèle « code »
BOOW_BRAIN_REASONING=        # modèle « généraliste / raisonnement »
BOOW_BRAIN_VISION=           # modèle « vision »
BOOW_BRAIN_FAST=             # modèle « rapide »
BOOW_BRAIN_CTX_DEFAULT=      # fenêtre de contexte supposée si inconnue (défaut : 32768)
BOOW_BRAIN_CTX_FORCE=        # plafonne la fenêtre pour tous les modèles (réglage/test)

# ── Outils externes ──────────────────────────────────────────────────────
BOOW_CHROME_CDP=             # défaut : http://localhost:9222 (recherche web via Chrome)
BOOW_CLAUDE_BIN=             # défaut : claude   (CLI Claude Code)
BOOW_HERMES_BIN=             # défaut : hermes   (agent local à mains, optionnel)

# ── Chemins ──────────────────────────────────────────────────────────────
BOOW_HERMES_CWD=             # dossier de travail des agents (défaut : ~/projects/boow-control)
BOOW_INDEX_ROOTS=            # racines indexées par la mémoire de recherche (défaut : ~/projects, ~/work)
